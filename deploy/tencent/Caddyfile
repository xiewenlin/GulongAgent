{
	auto_https off
	default_sni 111.229.70.235
}

http://111.229.70.235 {
	handle /.well-known/acme-challenge/* {
		root * /var/www/letsencrypt
		file_server
	}

	handle {
		redir https://111.229.70.235{uri} 308
	}
}

https://111.229.70.235 {
	tls /etc/caddy/certs/gulong-ip-fullchain.pem /etc/caddy/certs/gulong-ip-privkey.pem
	encode zstd gzip

	handle /api/v1/digital-live/realtime/* {
		reverse_proxy 127.0.0.1:8787 {
			flush_interval -1
		}
	}

	@loveLetterApi path /api/love-letters /api/love-letters/*
	handle @loveLetterApi {
		header >Referrer-Policy "no-referrer"
		header >Cache-Control "private, no-store"
		header >X-Robots-Tag "noindex, nofollow, noarchive"
		reverse_proxy 127.0.0.1:8787
	}

	handle /api/* {
		reverse_proxy 127.0.0.1:8787
	}

	handle /assets/* {
		root * /opt/gulong/current/dist/client
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	@loveLetter path /love-letter /love-letter/*
	handle @loveLetter {
		root * /opt/gulong/current/dist/client
		header Cache-Control "private, no-store"
		header >Referrer-Policy "no-referrer"
		header X-Robots-Tag "noindex, nofollow, noarchive"
		try_files {path} /index.html
		file_server
	}

	handle {
		root * /opt/gulong/current/dist/client
		header Cache-Control "no-store, max-age=0, must-revalidate"
		header Pragma "no-cache"
		header Expires "0"
		try_files {path} /index.html
		file_server
	}

	header {
		-Server
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
	}
}
