# MongoDB Atlas. Never expose this value with a VITE_ prefix.
MONGODB_URI=
MONGODB_DB=gulong_platform
ACTIVATION_SIGNING_PRIVATE_KEY_B64=

# Required in production. Use at least 32 random bytes.
SESSION_SECRET=
API_KEY_PEPPER=
APP_ORIGIN=http://localhost:4173

# Chandler public OpenAPI: unified identity, subscriptions, wallet and offline credentials.
CHANDLER_API_BASE=https://api.chandler.work
# Vercel production uses this exact variable name for the Chandler v3.2 API Key.
GulongAgent=
CHANDLER_API_KEY=
CHANDLER_CLIENT_SECRET=
# Optional: pre-derived lowercase sha256(client_secret) for Webhook HMAC verification.
CHANDLER_WEBHOOK_HMAC_KEY=
CHANDLER_APPLICATION_ID=cm_89be865af1af48f4a83406f0cf1a472e
CHANDLER_AIROS_APPLICATION_ID=cm_8b022909f72d4daab8379517271e9658
CHANDLER_MONTHLY_PRICE_FEN=29800
CHANDLER_YEARLY_PRICE_FEN=298000
CRON_SECRET=

# Tencent Cloud COS: Second Brain ZIPs and Windows release packages.
# Use a least-privilege CAM sub-account; never expose these with VITE_ prefixes.
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
COS_BUCKET=gulong-1259744534
COS_REGION=ap-chengdu
COS_DOMAIN=gulong-1259744534.cos.ap-chengdu.myqcloud.com

# Shared only with the trusted Windows release worker.
RELEASE_WORKER_KEY=

# Vercel Blob remains limited to feedback screenshots.
BLOB_READ_WRITE_TOKEN=

# Legacy direct WeChat gateway fallback. Chandler v3.2 is the active cashier.
PAYMENT_MODE=mock
WECHATPAY_APP_ID=
WECHATPAY_MCH_ID=
WECHATPAY_SERIAL_NO=
WECHATPAY_PRIVATE_KEY=
WECHATPAY_PLATFORM_CERT=
WECHATPAY_API_V3_KEY=
WECHATPAY_NOTIFY_URL=

# Public download destinations, managed server-side.
DOWNLOAD_FEISHU_URL=
DOWNLOAD_QUARK_URL=
DOWNLOAD_BAIDU_URL=
DOWNLOAD_BAIDU_CODE=
