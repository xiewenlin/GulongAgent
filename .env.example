# MongoDB Atlas. Never expose this value with a VITE_ prefix.
MONGODB_URI=
MONGODB_DB=gulong_platform

# Required in production. Use at least 32 random bytes.
SESSION_SECRET=
API_KEY_PEPPER=
APP_ORIGIN=http://localhost:4173

# Vercel Blob is used for ZIP files and feedback screenshots.
BLOB_READ_WRITE_TOKEN=

# Payment mode: mock | live
PAYMENT_MODE=mock
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_NOTIFY_URL=
ALIPAY_RETURN_URL=
ALIPAY_AUTOPAY_PRODUCT_CODE=
WECHATPAY_APP_ID=
WECHATPAY_MCH_ID=
WECHATPAY_SERIAL_NO=
WECHATPAY_PRIVATE_KEY=
WECHATPAY_PLATFORM_CERT=
WECHATPAY_API_V3_KEY=
WECHATPAY_NOTIFY_URL=

# Public download destinations, managed server-side.
DOWNLOAD_FEISHU_URL=
DOWNLOAD_QUARK_URL=
DOWNLOAD_BAIDU_URL=
DOWNLOAD_BAIDU_CODE=
